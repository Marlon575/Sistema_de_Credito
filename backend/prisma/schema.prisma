// =============================================================
// schema.prisma — Desenho da base de dados do CréditoMZ
//
// Este ficheiro descreve todas as "tabelas" (chamadas "models"
// no Prisma) que vão existir na base de dados PostgreSQL.
//
// Depois de editar este ficheiro, corremos:
//   npx prisma migrate dev --name nome_da_alteracao
// e o Prisma cria/atualiza as tabelas reais na base de dados.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS — listas fixas de valores possíveis
// =============================================================

enum Perfil {
  ADMIN
  GERENTE
  FUNCIONARIO
  CLIENTE
}

enum StatusEmprestimo {
  PENDENTE
  EM_ANALISE
  APROVADO
  REJEITADO
  ATIVO
  QUITADO
}

// =============================================================
// MODELS — as tabelas da base de dados
// =============================================================

// ---- Usuario: qualquer pessoa que usa o sistema ----
model Usuario {
  id               Int      @id @default(autoincrement())
  nome             String
  email            String   @unique
  senhaHash        String
  perfil           Perfil
  ativo            Boolean  @default(true)
  bi               String?
  telefone         String?
  endereco         String?
  rendimentoMensal Float?
  tipoEmprego      String?
  emprego          String?
  dataCriacao      DateTime @default(now())

  emprestimosComoCliente Emprestimo[]    @relation("EmprestimosDoCliente")
  notificacoes           Notificacao[]
  refreshTokens          RefreshToken[]

  @@map("usuarios")
}

// ---- TipoEmprestimo: os 3 tipos de crédito disponíveis ----
model TipoEmprestimo {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  taxaMensal  Float
  taxaNominal Float
  prazoMin    Int
  prazoMax    Int
  valorMin    Float
  valorMax    Float

  emprestimos Emprestimo[]
  historico   HistoricoTipoEmprestimo[]

  @@map("tipos_emprestimo")
}

// ---- HistoricoTipoEmprestimo: regista cada alteração feita pelo admin ----
// às taxas, prazos ou valores de um tipo de crédito.
model HistoricoTipoEmprestimo {
  id               Int            @id @default(autoincrement())
  tipoEmprestimoId Int
  tipoEmprestimo   TipoEmprestimo @relation(fields: [tipoEmprestimoId], references: [id])

  adminId   Int
  adminNome String

  campoAlterado String
  valorAnterior String
  valorNovo     String

  data DateTime @default(now())

  @@map("historico_tipos_emprestimo")
}

// ---- Emprestimo: cada pedido de crédito feito por um cliente ----
model Emprestimo {
  id Int @id @default(autoincrement())

  clienteId Int
  cliente   Usuario @relation("EmprestimosDoCliente", fields: [clienteId], references: [id])

  tipoId      Int
  tipo        TipoEmprestimo @relation(fields: [tipoId], references: [id])
  valor       Float
  prazo       Int
  taxaMensal  Float
  taxaNominal Float

  valorParcela Float
  valorTotal   Float
  totalJuros   Float

  status         StatusEmprestimo @default(PENDENTE)
  motivoRejeicao String?

  observacoesFuncionario String?
  funcionarioId          Int?
  funcionarioNome        String?

  gerenteId   Int?
  gerenteNome String?

  parcelasPagas Int @default(0)

  dataPedido      DateTime  @default(now())
  dataAtualizacao DateTime  @updatedAt
  dataDecisao     DateTime?

  documentos   Documento[]
  pagamentos   Pagamento[]
  historico    HistoricoEmprestimo[]
  notificacoes Notificacao[]

  @@map("emprestimos")
}

// ---- Pagamento: cada prestação paga de um empréstimo ----
model Pagamento {
  id            Int        @id @default(autoincrement())
  emprestimoId  Int
  emprestimo    Emprestimo @relation(fields: [emprestimoId], references: [id])
  valorPago     Float
  numeroParcela Int
  dataPagamento DateTime   @default(now())
  registadoPor  String

  @@map("pagamentos")
}

// ---- Documento: ficheiros enviados pelo cliente (BI, comprovativo, etc.) ----
model Documento {
  id           Int        @id @default(autoincrement())
  emprestimoId Int
  emprestimo   Emprestimo @relation(fields: [emprestimoId], references: [id])
  tipo         String
  nomeOriginal String
  caminho      String
  dataUpload   DateTime   @default(now())

  @@map("documentos")
}

// ---- HistoricoEmprestimo: registo de cada ação tomada num pedido ----
model HistoricoEmprestimo {
  id           Int        @id @default(autoincrement())
  emprestimoId Int
  emprestimo   Emprestimo @relation(fields: [emprestimoId], references: [id])
  acao         String
  autor        String
  data         DateTime   @default(now())

  @@map("historico_emprestimos")
}

// ---- Notificacao: avisos mostrados a um utilizador ----
model Notificacao {
  id           Int         @id @default(autoincrement())
  usuarioId    Int
  usuario      Usuario     @relation(fields: [usuarioId], references: [id])
  emprestimoId Int?
  emprestimo   Emprestimo? @relation(fields: [emprestimoId], references: [id])
  titulo       String
  mensagem     String
  lida         Boolean     @default(false)
  data         DateTime    @default(now())

  @@map("notificacoes")
}

// ---- RefreshToken: tokens de longa duração usados para renovar o login ----
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  expiraEm  DateTime
  criado    DateTime @default(now())

  @@map("refresh_tokens")
}